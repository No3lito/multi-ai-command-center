# Copy to .env and fill in locally. Never commit .env (it is in .gitignore).
# Generate strong values with:  openssl rand -hex 24

# Dashboard sign-in (12+ characters)
OWNER_PASSWORD=
OWNER_DISPLAY_NAME=Noel

# Database (use letters and digits only, since it is embedded in a connection URL)
POSTGRES_USER=command_center
POSTGRES_PASSWORD=
POSTGRES_DB=command_center

# Browser origins allowed to call the API and open WebSockets
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ---- Milestone B onward (leave empty until then) ----
# Model providers (API keys, not consumer subscriptions)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Hard cap on live API spend for testing, in US dollars
LIVE_TEST_BUDGET_USD=10.00
