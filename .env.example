# Copy to .env and fill in locally. Never commit .env (it is in .gitignore).
# Generate strong values with:  openssl rand -hex 24

# Dashboard sign-in (12+ characters)
OWNER_PASSWORD=
OWNER_DISPLAY_NAME=Noel

# Database (use letters and digits only, since it is embedded in a connection URL)
POSTGRES_USER=command_center
POSTGRES_PASSWORD=
POSTGRES_DB=command_center

# Browser origins allowed to call the API and open WebSockets
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ---- AI providers (Milestone B) ----
# live: agents call the real Anthropic and OpenAI APIs (a missing key shows an error, never a fake answer)
# simulated: free local stand-ins, every message labeled SIMULATED
PROVIDER_MODE=live
# API keys from console.anthropic.com and platform.openai.com (not ChatGPT or Claude.ai subscriptions)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Hard cap on total real API spend in US dollars, checked before every paid request
LIVE_BUDGET_USD=10.00
