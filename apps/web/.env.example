# Only needed for `npm run dev` on :3000. Leave unset in production builds so
# the app derives the WebSocket URL from window.location (same origin).
NEXT_PUBLIC_WS_BASE=ws://localhost:8000

# Optional: where the dev server proxies /api (default http://127.0.0.1:8000).
# CC_DEV_API_TARGET=http://127.0.0.1:8000
